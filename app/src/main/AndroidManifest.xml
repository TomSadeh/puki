<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No Android backups: they'd copy the child's name and the pairing code to the cloud -->
    <!-- Reaches the companion "brain" on the family PC over the home network, and asks GitHub
         whether there's a newer game (nothing about the child is sent anywhere else) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a game update; Android asks the parent to confirm each one -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Hold the parrot to talk to it; the recording goes to the family PC only -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".OlamKatanApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OlamKatan"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|locale"
            android:theme="@style/Theme.OlamKatan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Android's answers while an update installs (update/Updater.kt) -->
        <receiver android:name=".update.InstallResultReceiver" android:exported="false" />
    </application>

</manifest>
