<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the tablet: no cloud backup and no copying to a new device (the child's name,
     the pairing code, Puki's reports). allowBackup="false" alone doesn't stop device transfer on
     Android 12 and up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
