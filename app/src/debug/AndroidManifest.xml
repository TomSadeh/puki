<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a self-test for the device brain's text code, run over adb:
     adb shell am broadcast -n io.github.tomsadeh.puki/.SelfTestReceiver ; adb logcat -s PukiSelfTest
     Add  -e host <ip:port> -e code <CODE> -e pin <fingerprint>  to also check the HTTPS
     connection to that PC (tls.fingerprint() on the PC gives the fingerprint) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".SelfTestReceiver" android:exported="true" />
    </application>
</manifest>
